set(KER_ETH_IMPORT "${PROJECT_BINARY_DIR}/linux-ethernet")
set(KER_ETH_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-ethernet-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-ethernet.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_ETH_MANIFEST}" --out "${KER_ETH_IMPORT}"
    RESULT_VARIABLE ker_eth_result ERROR_VARIABLE ker_eth_error)
if(NOT ker_eth_result EQUAL 0)
    message(FATAL_ERROR "Linux Ethernet import failed: ${ker_eth_error}")
endif()
file(READ "${KER_ETH_MANIFEST}" ker_eth_manifest_json)
string(JSON ker_eth_files LENGTH "${ker_eth_manifest_json}" files)
math(EXPR ker_eth_last "${ker_eth_files} - 1")
foreach(ker_eth_index RANGE ${ker_eth_last})
    string(JSON ker_eth_file MEMBER "${ker_eth_manifest_json}" files ${ker_eth_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_eth_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_ETH_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-ethernet.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
add_library(ker_eth_headers INTERFACE)
target_include_directories(ker_eth_headers SYSTEM INTERFACE "${KER_ETH_IMPORT}")
target_link_libraries(ker_eth_headers INTERFACE ker_skb_headers)
add_library(ker_eth_port OBJECT "${KER_ETH_IMPORT}/linux_ethernet.c" src/runtime/ethernet.c)
target_link_libraries(ker_eth_port PRIVATE ker_eth_headers)
target_compile_features(ker_eth_port PRIVATE c_std_11)
set_target_properties(ker_eth_port PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
