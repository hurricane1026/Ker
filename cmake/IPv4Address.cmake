set(KER_ADDR_IMPORT "${PROJECT_BINARY_DIR}/linux-ipv4-address")
set(KER_ADDR_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-ipv4-address-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-ipv4-address.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_ADDR_MANIFEST}" --out "${KER_ADDR_IMPORT}"
    RESULT_VARIABLE ker_address_result ERROR_VARIABLE ker_address_error)
if(NOT ker_address_result EQUAL 0)
    message(FATAL_ERROR "Linux IPv4 address import failed: ${ker_address_error}")
endif()
file(READ "${KER_ADDR_MANIFEST}" ker_address_manifest_json)
string(JSON ker_address_files LENGTH "${ker_address_manifest_json}" files)
math(EXPR ker_address_last "${ker_address_files} - 1")
foreach(ker_address_index RANGE ${ker_address_last})
    string(JSON ker_address_file MEMBER "${ker_address_manifest_json}" files ${ker_address_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_address_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_ADDR_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-ipv4-address.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
add_library(ker_address_headers INTERFACE)
target_include_directories(ker_address_headers SYSTEM INTERFACE "${KER_ADDR_IMPORT}")
target_link_libraries(ker_address_headers INTERFACE ker_eth_headers)
add_library(ker_address_port OBJECT "${KER_ADDR_IMPORT}/linux_ipv4_address.c" src/runtime/ipv4-address.c)
target_link_libraries(ker_address_port PRIVATE ker_address_headers)
target_compile_features(ker_address_port PRIVATE c_std_11)
set_target_properties(ker_address_port PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
