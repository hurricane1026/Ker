set(KER_ARP_IMPORT "${PROJECT_BINARY_DIR}/linux-arp")
set(KER_ARP_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-arp-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-arp.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_ARP_MANIFEST}" --out "${KER_ARP_IMPORT}"
    RESULT_VARIABLE ker_arp_result ERROR_VARIABLE ker_arp_error)
if(NOT ker_arp_result EQUAL 0)
    message(FATAL_ERROR "Linux ARP import failed: ${ker_arp_error}")
endif()
file(READ "${KER_ARP_MANIFEST}" ker_arp_manifest_json)
string(JSON ker_arp_files LENGTH "${ker_arp_manifest_json}" files)
math(EXPR ker_arp_last "${ker_arp_files} - 1")
foreach(ker_arp_index RANGE ${ker_arp_last})
    string(JSON ker_arp_file MEMBER "${ker_arp_manifest_json}" files ${ker_arp_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_arp_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_ARP_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-arp.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
add_library(ker_arp_headers INTERFACE)
target_include_directories(ker_arp_headers SYSTEM INTERFACE "${KER_ARP_IMPORT}")
target_link_libraries(ker_arp_headers INTERFACE ker_eth_headers)
add_library(ker_arp_port OBJECT "${KER_ARP_IMPORT}/linux_arp.c" src/runtime/arp.c)
target_link_libraries(ker_arp_port PRIVATE ker_arp_headers ker_address_headers)
target_compile_features(ker_arp_port PRIVATE c_std_11)
set_target_properties(ker_arp_port PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)

set(KER_ARP_PROBE_IMPORT "${PROJECT_BINARY_DIR}/linux-arp-probe")
set(KER_ARP_PROBE_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-arp-probe-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-arp-probe.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_ARP_PROBE_MANIFEST}" --out "${KER_ARP_PROBE_IMPORT}"
    RESULT_VARIABLE ker_arp_probe_result ERROR_VARIABLE ker_arp_probe_error)
if(NOT ker_arp_probe_result EQUAL 0)
    message(FATAL_ERROR "Linux ARP probe import failed: ${ker_arp_probe_error}")
endif()
file(READ "${KER_ARP_PROBE_MANIFEST}" ker_arp_probe_manifest_json)
string(JSON ker_arp_probe_files LENGTH "${ker_arp_probe_manifest_json}" files)
math(EXPR ker_arp_probe_last "${ker_arp_probe_files} - 1")
foreach(ker_arp_probe_index RANGE ${ker_arp_probe_last})
    string(JSON ker_arp_probe_file MEMBER "${ker_arp_probe_manifest_json}" files ${ker_arp_probe_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_arp_probe_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_ARP_PROBE_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-arp-probe.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
