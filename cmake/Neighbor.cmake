set(KER_NEIGH_IMPORT "${PROJECT_BINARY_DIR}/linux-neighbor")
set(KER_NEIGH_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-neighbor-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-neighbor.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_NEIGH_MANIFEST}" --out "${KER_NEIGH_IMPORT}"
    RESULT_VARIABLE ker_neighbor_result ERROR_VARIABLE ker_neighbor_error)
if(NOT ker_neighbor_result EQUAL 0)
    message(FATAL_ERROR "Linux neighbor import failed: ${ker_neighbor_error}")
endif()
file(READ "${KER_NEIGH_MANIFEST}" ker_neighbor_manifest_json)
string(JSON ker_neighbor_files LENGTH "${ker_neighbor_manifest_json}" files)
math(EXPR ker_neighbor_last "${ker_neighbor_files} - 1")
foreach(ker_neighbor_index RANGE ${ker_neighbor_last})
    string(JSON ker_neighbor_file MEMBER "${ker_neighbor_manifest_json}" files ${ker_neighbor_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_neighbor_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_NEIGH_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-neighbor.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
add_library(ker_neighbor_headers INTERFACE)
target_include_directories(ker_neighbor_headers SYSTEM INTERFACE "${KER_NEIGH_IMPORT}")
target_link_libraries(ker_neighbor_headers INTERFACE ker_address_headers ker_napi_headers)
add_library(ker_neighbor_port OBJECT "${KER_NEIGH_IMPORT}/linux_neighbor.c" src/runtime/neighbor.c src/runtime/skb-queue.c)
target_link_libraries(ker_neighbor_port PRIVATE ker_neighbor_headers)
target_compile_features(ker_neighbor_port PRIVATE c_std_11)
set_target_properties(ker_neighbor_port PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
