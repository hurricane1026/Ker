set(KER_NAPI_IMPORT "${PROJECT_BINARY_DIR}/linux-napi")
set(KER_NAPI_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-napi-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-napi.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_NAPI_MANIFEST}" --out "${KER_NAPI_IMPORT}"
    RESULT_VARIABLE ker_napi_result ERROR_VARIABLE ker_napi_error)
if(NOT ker_napi_result EQUAL 0)
    message(FATAL_ERROR "Linux NAPI import failed: ${ker_napi_error}")
endif()
file(READ "${KER_NAPI_MANIFEST}" ker_napi_manifest_json)
string(JSON ker_napi_files LENGTH "${ker_napi_manifest_json}" files)
math(EXPR ker_napi_last "${ker_napi_files} - 1")
foreach(ker_napi_index RANGE ${ker_napi_last})
    string(JSON ker_napi_file MEMBER "${ker_napi_manifest_json}" files ${ker_napi_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_napi_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_NAPI_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-napi.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
add_library(ker_napi_headers INTERFACE)
target_include_directories(ker_napi_headers SYSTEM INTERFACE "${KER_NAPI_IMPORT}")
target_link_libraries(ker_napi_headers INTERFACE ker_eth_headers)
add_library(ker_napi_port OBJECT "${KER_NAPI_IMPORT}/linux_napi.c" src/runtime/napi.c)
target_link_libraries(ker_napi_port PRIVATE ker_napi_headers)
target_compile_features(ker_napi_port PRIVATE c_std_11)
set_target_properties(ker_napi_port PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
