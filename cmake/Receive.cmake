set(KER_RX_IMPORT "${PROJECT_BINARY_DIR}/linux-receive")
set(KER_RX_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-receive-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-receive.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_RX_MANIFEST}" --out "${KER_RX_IMPORT}"
    RESULT_VARIABLE ker_receive_result ERROR_VARIABLE ker_receive_error)
if(NOT ker_receive_result EQUAL 0)
    message(FATAL_ERROR "Linux Receive import failed: ${ker_receive_error}")
endif()
file(READ "${KER_RX_MANIFEST}" ker_receive_manifest_json)
string(JSON ker_receive_files LENGTH "${ker_receive_manifest_json}" files)
math(EXPR ker_receive_last "${ker_receive_files} - 1")
foreach(ker_receive_index RANGE ${ker_receive_last})
    string(JSON ker_receive_file MEMBER "${ker_receive_manifest_json}" files ${ker_receive_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_receive_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_RX_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-receive.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
add_library(ker_receive_headers INTERFACE)
target_include_directories(ker_receive_headers SYSTEM INTERFACE "${KER_RX_IMPORT}")
target_link_libraries(ker_receive_headers INTERFACE ker_napi_headers)
add_library(ker_receive_port OBJECT "${KER_RX_IMPORT}/linux_receive.c" src/runtime/receive.c)
target_link_libraries(ker_receive_port PRIVATE ker_receive_headers)
target_compile_features(ker_receive_port PRIVATE c_std_11)
set_target_properties(ker_receive_port PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
