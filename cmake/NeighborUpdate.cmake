set(KER_NEIGH_UPDATE_IMPORT "${PROJECT_BINARY_DIR}/linux-neighbor-update")
set(KER_NEIGH_UPDATE_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-neighbor-update-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-neighbor-update.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_NEIGH_UPDATE_MANIFEST}" --out "${KER_NEIGH_UPDATE_IMPORT}"
    RESULT_VARIABLE ker_neighbor_update_result ERROR_VARIABLE ker_neighbor_update_error)
if(NOT ker_neighbor_update_result EQUAL 0)
    message(FATAL_ERROR "Linux neighbor update import failed: ${ker_neighbor_update_error}")
endif()
file(READ "${KER_NEIGH_UPDATE_MANIFEST}" ker_neighbor_update_manifest_json)
string(JSON ker_neighbor_update_files LENGTH "${ker_neighbor_update_manifest_json}" files)
math(EXPR ker_neighbor_update_last "${ker_neighbor_update_files} - 1")
foreach(ker_neighbor_update_index RANGE ${ker_neighbor_update_last})
    string(JSON ker_neighbor_update_file MEMBER "${ker_neighbor_update_manifest_json}" files ${ker_neighbor_update_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_neighbor_update_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_NEIGH_UPDATE_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-neighbor-update.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
add_library(ker_neighbor_update_headers INTERFACE)
target_include_directories(ker_neighbor_update_headers SYSTEM INTERFACE "${KER_NEIGH_UPDATE_IMPORT}")
target_link_libraries(ker_neighbor_update_headers INTERFACE ker_neighbor_timer_headers ker_arp_headers)
target_include_directories(ker_neighbor_timer_port PRIVATE "${KER_NEIGH_UPDATE_IMPORT}")
target_link_libraries(ker_neighbor_timer_port PRIVATE ker_neighbor_update_headers)
add_library(ker_neighbor_update_port OBJECT "${KER_NEIGH_UPDATE_IMPORT}/linux_neighbor_update.c" src/runtime/neighbor-update.c)
target_link_libraries(ker_neighbor_update_port PRIVATE ker_neighbor_update_headers)
target_compile_features(ker_neighbor_update_port PRIVATE c_std_11)
set_target_properties(ker_neighbor_update_port PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
