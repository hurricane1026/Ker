set(KER_NEIGH_TIMER_IMPORT "${PROJECT_BINARY_DIR}/linux-neighbor-timer")
set(KER_NEIGH_TIMER_MANIFEST "${PROJECT_SOURCE_DIR}/src/compat/linux-neighbor-timer-manifest.json")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/import-linux-neighbor-timer.py"
    --linux "${KER_LINUX_DIR}" --manifest "${KER_NEIGH_TIMER_MANIFEST}" --out "${KER_NEIGH_TIMER_IMPORT}"
    RESULT_VARIABLE ker_neighbor_timer_result ERROR_VARIABLE ker_neighbor_timer_error)
if(NOT ker_neighbor_timer_result EQUAL 0)
    message(FATAL_ERROR "Linux neighbor import failed: ${ker_neighbor_timer_error}")
endif()
file(READ "${KER_NEIGH_TIMER_MANIFEST}" ker_neighbor_timer_manifest_json)
string(JSON ker_neighbor_timer_files LENGTH "${ker_neighbor_timer_manifest_json}" files)
math(EXPR ker_neighbor_timer_last "${ker_neighbor_timer_files} - 1")
foreach(ker_neighbor_timer_index RANGE ${ker_neighbor_timer_last})
    string(JSON ker_neighbor_timer_file MEMBER "${ker_neighbor_timer_manifest_json}" files ${ker_neighbor_timer_index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_LINUX_DIR}/${ker_neighbor_timer_file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KER_NEIGH_TIMER_MANIFEST}"
    "${PROJECT_SOURCE_DIR}/tools/import-linux-neighbor-timer.py" "${PROJECT_SOURCE_DIR}/tools/import-linux-skb.py")
add_library(ker_neighbor_timer_headers INTERFACE)
target_include_directories(ker_neighbor_timer_headers SYSTEM INTERFACE "${KER_NEIGH_TIMER_IMPORT}")
target_link_libraries(ker_neighbor_timer_headers INTERFACE ker_neighbor_headers ker_timer_list_headers)
add_library(ker_neighbor_timer_port OBJECT "${KER_NEIGH_TIMER_IMPORT}/linux_neighbor_timer.c" src/runtime/neighbor-timer.c)
target_link_libraries(ker_neighbor_timer_port PRIVATE ker_neighbor_timer_headers)
target_compile_features(ker_neighbor_timer_port PRIVATE c_std_11)
set_target_properties(ker_neighbor_timer_port PROPERTIES POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET hidden)
