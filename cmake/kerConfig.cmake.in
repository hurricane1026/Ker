@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@KER_WITH_DPDK@)
    find_dependency(PkgConfig)
    pkg_check_modules(DPDK REQUIRED IMPORTED_TARGET libdpdk>=26.11.0)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/kerTargets.cmake")
if(@KER_WITH_DPDK@)
    foreach(ker_dpdk_libdir IN LISTS DPDK_LIBRARY_DIRS)
        set_property(TARGET ker::ker APPEND PROPERTY INTERFACE_LINK_OPTIONS
            "LINKER:-rpath-link,${ker_dpdk_libdir}")
    endforeach()
endif()
check_required_components(ker)
